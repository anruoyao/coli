NLLB_MODEL_DIR=/opt/models/nllb-200-distilled-600M-ct2-int8
NLLB_TOKENIZER_DIR=/opt/models/nllb-200-distilled-600M-ct2-int8
NLLB_THREADS=2
# Set a strong shared key; runtime administration is disabled without it.
NLLB_API_KEY=
